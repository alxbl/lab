#!/usr/bin/env bash
# Creates the Keycloak Secrets that cannot live in git. Values are read from the terminal or generated, never
# taken from arguments. Re-running keeps Secrets that already exist.
#   keycloak-bootstrap-admin   generated admin password for the master realm
#   keycloak-github            GitHub OAuth app client id and secret (prompted; only with --github)
set -euo pipefail

NS=keycloak

exists() { kubectl -n "$NS" get secret "$1" >/dev/null 2>&1; }

if ! exists keycloak-bootstrap-admin; then
  openssl rand -base64 24 | tr -d '\n' |
    kubectl -n "$NS" create secret generic keycloak-bootstrap-admin \
      --from-literal=username=admin --from-file=password=/dev/stdin
fi

if [[ "${1:-}" == "--github" ]] && ! exists keycloak-github; then
  read -rp "GitHub OAuth client id: " id
  read -rsp "GitHub OAuth client secret: " secret; echo
  kubectl -n "$NS" create secret generic keycloak-github \
    --from-file=client-id=<(printf %s "$id") --from-file=client-secret=<(printf %s "$secret")
fi
