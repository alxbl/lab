#!/usr/bin/env bash
# Creates and refreshes media/paperless-secrets, the environment file of the Paperless-ngx pod. Generated values are kept
# across runs; the OIDC providers JSON is derived from keycloak/keycloak-paperless (create that first with
# scripts/keycloak-secrets) and refreshed on every run, so rerun it after rotating the client secret, then restart the pod.
# Values are generated or copied, never taken from arguments.
#   PAPERLESS_SECRET_KEY, PAPERLESS_ADMIN_PASSWORD   generated
#   PAPERLESS_ADMIN_USER, PAPERLESS_ADMIN_MAIL       bootstrap superuser (local login; Keycloak users are not admins)
#   PAPERLESS_SOCIALACCOUNT_PROVIDERS                Keycloak realm segv, client "paperless", provider id "keycloak"
set -euo pipefail

python3 -I - <<'PY' | kubectl apply --server-side --force-conflicts -f -
import base64, json, secrets, subprocess

def secret_data(ns, name):
    r = subprocess.run(["kubectl", "-n", ns, "get", "secret", name, "-o", "json"], capture_output=True, text=True)
    if r.returncode:
        return None
    return {k: base64.b64decode(v).decode() for k, v in json.loads(r.stdout)["data"].items()}

old = secret_data("media", "paperless-secrets") or {}
kc = secret_data("keycloak", "keycloak-paperless")
if kc is None:
    raise SystemExit("keycloak/keycloak-paperless is missing: run scripts/keycloak-secrets first")

providers = {"openid_connect": {
    "SCOPE": ["openid", "profile", "email"],
    "OAUTH_PKCE_ENABLED": True,
    "APPS": [{
        "provider_id": "keycloak", "name": "Keycloak", "client_id": "paperless", "secret": kc["client-secret"],
        "settings": {"server_url": "https://segfault.me/auth/realms/segv/.well-known/openid-configuration"},
    }],
}}
data = {
    "PAPERLESS_SECRET_KEY": old.get("PAPERLESS_SECRET_KEY") or secrets.token_urlsafe(64),
    "PAPERLESS_ADMIN_USER": "paperless-admin",
    "PAPERLESS_ADMIN_MAIL": "admin@segfault.me",
    "PAPERLESS_ADMIN_PASSWORD": old.get("PAPERLESS_ADMIN_PASSWORD") or secrets.token_urlsafe(24),
    "PAPERLESS_SOCIALACCOUNT_PROVIDERS": json.dumps(providers),
}
print(json.dumps({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": "paperless-secrets", "namespace": "media"},
                  "type": "Opaque", "stringData": data}))
PY
