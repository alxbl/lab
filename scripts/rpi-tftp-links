#!/usr/bin/env bash
# USAGE: ./scripts/rpi-tftp-links [groups-dir] [tftp-dir]
#
# Links tftp/<mac> to tftp/rpi4 for every rpi4-*.json matchbox group. With
# TFTP_PREFIX=2 (see build/bootstrap/rpi4/boot.conf) a Pi 4 requests its files
# from a directory named after its MAC address, lowercase and hyphenated.
# A Pi whose EEPROM has not been updated yet still uses its serial number, so a
# group with metadata.serial also gets a tftp/<serial> link.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
GROUPS_DIR=${1:-$ROOT/build/bootstrap/matchbox/groups}
TFTP_DIR=${2:-$ROOT/build/bootstrap/tftp}

for group in "$GROUPS_DIR"/rpi4-*.json; do
  [[ -e $group ]] || continue
  mac=$(jq -er '.selector.mac' "$group")
  link=$(tr 'A-F:' 'a-f-' <<<"$mac")
  ln -sfn rpi4 "$TFTP_DIR/$link"
  echo "$link -> rpi4"
  serial=$(jq -r '.metadata.serial // empty' "$group")
  if [[ -n $serial ]]; then
    ln -sfn rpi4 "$TFTP_DIR/$serial"
    echo "$serial -> rpi4"
  fi
done
