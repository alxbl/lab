#!/usr/bin/env bash
# Creates the Secrets Firefly III needs that cannot live in git. Values are generated, never taken from arguments.
# Re-running keeps Secrets that already exist.
#   home/firefly-secrets  app-key (APP_KEY, 32 chars; encrypts stored data, so losing it loses that data), cron-token
#                         (STATIC_CRON_TOKEN) and cron-skip-route (the one proxy path that needs no login, derived)
#   plus, through oauth2-proxy-secrets: keycloak/keycloak-firefly and home/firefly-oauth2-proxy
set -euo pipefail

NS=home
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

if ! kubectl -n "$NS" get secret firefly-secrets >/dev/null 2>&1; then
  cron=$(openssl rand -hex 16)
  {
    printf 'app-key=%s\n' "$(openssl rand -hex 16)"
    printf 'cron-token=%s\n' "$cron"
    printf 'cron-skip-route=^/api/v1/cron/%s$\n' "$cron"
  } | kubectl -n "$NS" create secret generic firefly-secrets --from-env-file=/dev/stdin
fi

"$HERE/oauth2-proxy-secrets" firefly "$NS"
