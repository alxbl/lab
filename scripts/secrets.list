# Kubernetes Secrets exported by export-secrets, one per line: <namespace>/<name> [optional]
# Required entries must exist or the export aborts before uploading anything.
# Values live only in Proton Drive (see README); this file holds names only.
cert-manager/cloudflare-api-secret
code/forgejo-admin
code/forgejo-database-app
code/forgejo-oauth
code/forgejo-runner-token
home/adguard-admin-password
keycloak/keycloak-admin
keycloak/keycloak-bootstrap-admin
# Generated by CNPG; the restored keycloak-db volume only accepts this password.
keycloak/keycloak-db-app
keycloak/keycloak-forgejo
keycloak/keycloak-github
keycloak/keycloak-immich
media/gluetun-config
media/gluetun-vpn-credentials
# Rendered by scripts/immich-config (carries the OAuth client secret).
media/immich-config
# Generated by CNPG; restored without an ownerReference, so CNPG keeps it and the existing database password stays valid.
media/immich-database-app
media/photoprism-secrets
media/qbt-admin-password
media/smbd-credentials
monitoring/grafana-admin
# Kopia repository password: without it the Azure backups cannot be read.
system/velero-azure-storage-key
system/velero-env-secret
system/velero-repo-credentials
cert-manager/letsencrypt-key optional
# Wildcard certificate and key served by the gateway; restoring it avoids an outage and a Let's Encrypt reissue (rate limits).
gateway/https-in-gw-tls optional
