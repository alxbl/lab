        "contents": "[Unit]\nDescription=Install Fedora CoreOS and Raspberry Pi 4 firmware\nAfter=network-online.target\nWants=network-online.target\n\n[Service]\nType=oneshot\nExecStart=/usr/local/bin/rpi4-install\nExecStartPost=/usr/bin/systemctl --no-block reboot\n\n[Install]\nWantedBy=multi-user.target\n"
