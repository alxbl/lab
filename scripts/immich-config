#!/usr/bin/env bash
# Renders the Immich configuration Secret (media/immich-config) from infra/k8s/immich/config/immich-config.json with the
# Keycloak client secret (keycloak/keycloak-immich) filled in, and applies it. Run it before the first sync of the immich
# Application and again after changing the JSON or rotating the client secret; Immich reads the file at start, so restart
# immich-server afterwards. The Secret is derived, so it is not in scripts/secrets.list.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

python3 -I - "$ROOT/infra/k8s/immich/config/immich-config.json" <<'PY' | kubectl apply --server-side --force-conflicts -f -
import base64, json, subprocess, sys

cfg = json.load(open(sys.argv[1]))
cfg["oauth"]["clientSecret"] = base64.b64decode(subprocess.check_output(
    ["kubectl", "-n", "keycloak", "get", "secret", "keycloak-immich", "-o", "jsonpath={.data.client-secret}"])).decode()
print(json.dumps({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": "immich-config", "namespace": "media"},
                  "type": "Opaque", "stringData": {"immich-config.yaml": json.dumps(cfg, indent=2)}}))
PY
