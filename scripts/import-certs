#!/usr/bin/env bash
# USAGE: scripts/import-certs [--cluster NAME]
#
# Copies the public certificates (ca.crt and issued/*.crt) stored in Proton Drive at
# $LAB_SECRETS_REMOTE/<cluster>/pki into pki/ of the repository. Private keys are never copied.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
REMOTE_ROOT=${LAB_SECRETS_REMOTE:-/my-files/Documents/Homelab/_secrets}
CLUSTER=segv

while [[ $# -gt 0 ]]; do
  case $1 in
    --cluster) CLUSTER=${2:?--cluster needs a name}; shift 2 ;;
    *) sed -n '2,7p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
  esac
done

STAGE=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/dev/shm}")
chmod 700 "$STAGE"
trap 'rm -rf "$STAGE"' EXIT

proton-drive filesystem download -f remove -d merge "$REMOTE_ROOT/$CLUSTER/pki" "$STAGE"
PKI=$(find "$STAGE" -type d -name pki | head -1)
[[ -f $PKI/ca.crt ]] || { echo "no ca.crt under $REMOTE_ROOT/$CLUSTER/pki" >&2; exit 1; }

echo "Copying ca.crt..."
cp "$PKI/ca.crt" "$ROOT/pki/ca.crt"
while IFS= read -r f; do
  echo "Copying $(basename "$f")..."
  cp "$f" "$ROOT/pki/"
done < <(find "$PKI/issued" -name '*.crt' 2>/dev/null)
