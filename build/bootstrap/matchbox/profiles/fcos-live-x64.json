{
  "id": "fcos-live-x64",
  "name": "Fedora CoreOS Live (x64)",
  "boot": {
    "kernel": "/assets/fedora-coreos/fedora-coreos-44.20260913.3.2-live-kernel.x86_64",
    "initrd": [
      "--name main /assets/fedora-coreos/fedora-coreos-44.20260913.3.2-live-initramfs.x86_64.img"
    ],
    "args": [
      "initrd=main",
      "coreos.live.rootfs_url=http://matchbox.lan:8080/assets/fedora-coreos/fedora-coreos-44.20260913.3.2-live-rootfs.x86_64.img",
      "systemd.journald.max_level_console=debug",
      "console=tty0",
      "console=ttyS1,115200n8",
      "ignition.firstboot",
      "ignition.platform.id=metal",
      "ignition.config.url=http://matchbox.lan:8080/ignition?uuid=${uuid}&mac=${mac:hexhyp}&buildarch=${buildarch:uristring}"
    ]
  },
  "ignition_id": "fcos-live.ign"
}
