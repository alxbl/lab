{
  "id": "install-arm64",
  "name": "Fedora CoreOS install (ARM64, Raspberry Pi 4)",
  "boot": {
    "kernel": "/assets/fedora-coreos/fedora-coreos-44.20260928.3.1-live-kernel.aarch64",
    "initrd": [
      "--name main /assets/fedora-coreos/fedora-coreos-44.20260928.3.1-live-initramfs.aarch64.img"
    ],
    "args": [
      "initrd=main",
      "coreos.live.rootfs_url=http://matchbox.lan:8080/assets/fedora-coreos/fedora-coreos-44.20260928.3.1-live-rootfs.aarch64.img",
      "ignition.firstboot",
      "ignition.platform.id=metal",
      "ignition.config.url=http://matchbox.lan:8080/ignition?uuid=${uuid}&mac=${mac:hexhyp}&buildarch=${buildarch:uristring}"
    ]
  },
  "ignition_id": "rpi4-install.ign"
}
