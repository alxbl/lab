#!/usr/bin/env bash
# USAGE: scripts/export-secrets [--cluster NAME] <kubeconfig>
#
# Exports the Secrets listed in scripts/secrets.list from the cluster behind
# <kubeconfig> to Proton Drive: $LAB_SECRETS_REMOTE/<cluster>/manifests/<namespace>/<name>.yaml
# Cluster-specific metadata is stripped so the files re-apply cleanly with import-secrets.
# Uploads create a new file revision when content changed. Only reads from the cluster.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
REMOTE_ROOT=${LAB_SECRETS_REMOTE:-/my-files/Documents/Homelab/_secrets}
LIST=${SECRETS_LIST:-$ROOT/scripts/secrets.list}
CLUSTER=segv

usage() { sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

while [[ $# -gt 0 ]]; do
  case $1 in
    --cluster) CLUSTER=${2:?--cluster needs a name}; shift 2 ;;
    -h|--help) usage ;;
    -*) echo "unknown option: $1" >&2; usage ;;
    *) break ;;
  esac
done
[[ $# -eq 1 ]] || usage
KUBECONFIG_FILE=$1
[[ -r $KUBECONFIG_FILE ]] || { echo "cannot read kubeconfig: $KUBECONFIG_FILE" >&2; exit 1; }
[[ -r $LIST ]] || { echo "cannot read secrets list: $LIST" >&2; exit 1; }
K=(kubectl --kubeconfig "$KUBECONFIG_FILE")

STAGE=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/dev/shm}")
chmod 700 "$STAGE"
trap 'rm -rf "$STAGE"' EXIT
OUT=$STAGE/manifests

SCRUB='del(.metadata.uid, .metadata.resourceVersion, .metadata.creationTimestamp,
           .metadata.managedFields, .metadata.ownerReferences, .metadata.selfLink, .metadata.generation)
       | del(.metadata.annotations["kubectl.kubernetes.io/last-applied-configuration"])
       | if (.metadata.annotations // {}) == {} then del(.metadata.annotations) else . end'

missing=()
exported=()
while read -r ref flag; do
  [[ -z $ref || $ref == \#* ]] && continue
  ns=${ref%%/*} name=${ref#*/}
  if ! json=$("${K[@]}" -n "$ns" get secret "$name" -o json 2>/dev/null); then
    if [[ ${flag:-} == optional ]]; then echo "skip (optional, not found): $ref"; else missing+=("$ref"); fi
    continue
  fi
  mkdir -p "$OUT/$ns"
  jq "$SCRUB" <<<"$json" | "${K[@]}" create --dry-run=client -o yaml -f - >"$OUT/$ns/$name.yaml"
  exported+=("$ref")
done <"$LIST"

if ((${#missing[@]})); then
  printf 'missing required secret: %s\n' "${missing[@]}" >&2
  echo "nothing uploaded" >&2
  exit 1
fi
((${#exported[@]})) || { echo "no secrets exported" >&2; exit 1; }

ensure_remote_dir() {
  proton-drive filesystem info "$1" >/dev/null 2>&1 \
    || proton-drive filesystem create-folder "$(dirname "$1")" "$(basename "$1")"
}
ensure_remote_dir "$REMOTE_ROOT"
ensure_remote_dir "$REMOTE_ROOT/$CLUSTER"
proton-drive filesystem upload -f create-new-revision -d merge -t "$OUT" "$REMOTE_ROOT/$CLUSTER"

printf 'exported to %s/%s/manifests:\n' "$REMOTE_ROOT" "$CLUSTER"
printf '  %s\n' "${exported[@]}"
