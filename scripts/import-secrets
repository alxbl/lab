#!/usr/bin/env bash
# USAGE: scripts/import-secrets [--cluster NAME] [--dry-run] <kubeconfig> [namespace...]
#
# Applies the Secrets stored in Proton Drive by export-secrets
# ($LAB_SECRETS_REMOTE/<cluster>/manifests/<namespace>/<name>.yaml)
# to the cluster behind <kubeconfig>, creating missing namespaces first. With namespaces
# given, only those are imported. --dry-run changes nothing (namespaces are not created, and
# secrets in missing namespaces are only validated client side).
set -euo pipefail

REMOTE_ROOT=${LAB_SECRETS_REMOTE:-/my-files/Documents/Homelab/_secrets}
CLUSTER=segv
DRY=0

usage() { sed -n '2,10p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

while [[ $# -gt 0 ]]; do
  case $1 in
    --cluster) CLUSTER=${2:?--cluster needs a name}; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) usage ;;
    -*) echo "unknown option: $1" >&2; usage ;;
    *) break ;;
  esac
done
[[ $# -ge 1 ]] || usage
KUBECONFIG_FILE=$1; shift
ONLY=("$@")
[[ -r $KUBECONFIG_FILE ]] || { echo "cannot read kubeconfig: $KUBECONFIG_FILE" >&2; exit 1; }
K=(kubectl --kubeconfig "$KUBECONFIG_FILE")

STAGE=$(mktemp -d -p "${XDG_RUNTIME_DIR:-/dev/shm}")
chmod 700 "$STAGE"
trap 'rm -rf "$STAGE"' EXIT

proton-drive filesystem download -f remove -d merge "$REMOTE_ROOT/$CLUSTER/manifests" "$STAGE"
SRC=$(find "$STAGE" -type d -name manifests | head -1)
[[ -n $SRC ]] || { echo "no manifests found at $REMOTE_ROOT/$CLUSTER/manifests" >&2; exit 1; }

echo "target: $("${K[@]}" config view --minify -o jsonpath='{.clusters[0].cluster.server}')"
verb=applied
((DRY)) && verb="would apply"
count=0
for dir in "$SRC"/*/; do
  [[ -d $dir ]] || continue
  ns=$(basename "$dir")
  if ((${#ONLY[@]})) && [[ ! " ${ONLY[*]} " == *" $ns "* ]]; then continue; fi
  mode=()
  if "${K[@]}" get namespace "$ns" >/dev/null 2>&1; then
    ((DRY)) && mode=(--dry-run=server)
  elif ((DRY)); then
    echo "namespace $ns does not exist (dry run: client-side validation only)"
    mode=(--dry-run=client)
  else
    "${K[@]}" create namespace "$ns" >/dev/null
    echo "created namespace $ns"
  fi
  for f in "$dir"*.yaml; do
    [[ -e $f ]] || continue
    "${K[@]}" apply "${mode[@]}" -f "$f" >/dev/null
    echo "$verb $ns/$(basename "$f" .yaml)"
    count=$((count + 1))
  done
done
((count)) || { echo "nothing imported" >&2; exit 1; }
echo "done: $count secrets"
