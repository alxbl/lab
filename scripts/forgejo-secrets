#!/usr/bin/env bash
# Creates the Secrets in the code namespace that cannot live in git. Values are generated or copied between
# Secrets, never taken from arguments. Re-running keeps Secrets that already exist, except forgejo-oauth, which
# is derived and always refreshed.
#   forgejo-admin         break-glass local admin (generated password)
#   forgejo-oauth         key and secret of the Keycloak client (copied from keycloak/keycloak-forgejo)
#   forgejo-runner-token  registration token for the Actions runners (needs the forgejo Deployment running; with
#                         --runner-token only)
set -euo pipefail

NS=code

exists() { kubectl -n "$NS" get secret "$1" >/dev/null 2>&1; }

if ! exists forgejo-admin; then
  openssl rand -base64 24 | tr -d '\n' |
    kubectl -n "$NS" create secret generic forgejo-admin \
      --from-literal=username=forgejo-admin --from-file=password=/dev/stdin
fi

kubectl -n keycloak get secret keycloak-forgejo -o json |
  python3 -I -c '
import base64, json, sys
s = base64.b64decode(json.load(sys.stdin)["data"]["client-secret"]).decode()
print(json.dumps({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": "forgejo-oauth", "namespace": "code"},
                  "type": "Opaque", "stringData": {"key": "forgejo", "secret": s}}))' |
  kubectl apply --server-side --force-conflicts -f -

if [[ "${1:-}" == "--runner-token" ]] && ! exists forgejo-runner-token; then
  kubectl -n "$NS" exec deploy/forgejo -- forgejo actions generate-runner-token |
    tr -d '\n' |
    kubectl -n "$NS" create secret generic forgejo-runner-token --from-file=token=/dev/stdin
fi
