#!/usr/bin/env bash
# Creates the Secrets an oauth2-proxy sidecar (infra/k8s/oauth2-proxy) needs for one app. Values are generated or
# copied between Secrets, never taken from arguments. Re-running keeps the generated values.
#   usage: oauth2-proxy-secrets <app> <namespace>
#   keycloak/keycloak-<app>     generated client secret of the app's Keycloak client (keycloak/oidcclient-<app>.yaml)
#   <namespace>/<app>-oauth2-proxy  client-id and client-secret (copied, always refreshed) and cookie-secret (generated)
set -euo pipefail

[[ $# -eq 2 && $1 =~ ^[a-z0-9-]+$ && $2 =~ ^[a-z0-9-]+$ ]] || { echo "usage: $0 <app> <namespace>" >&2; exit 2; }
APP=$1 NS=$2

exists() { kubectl -n "$1" get secret "$2" >/dev/null 2>&1; }

# Hex: the operator does not URL-encode the client secret, so base64 characters (+, /, =) break its token request.
if ! exists keycloak "keycloak-$APP"; then
  openssl rand -hex 24 | tr -d '\n' |
    kubectl -n keycloak create secret generic "keycloak-$APP" --from-file=client-secret=/dev/stdin
fi
# The operator reads a client's secret only if it carries this label.
kubectl -n keycloak label secret "keycloak-$APP" operator.keycloak.org/kind=KeycloakOIDCClient --overwrite >/dev/null

# 32 random bytes, URL-safe base64: a valid oauth2-proxy cookie secret.
if exists "$NS" "$APP-oauth2-proxy"; then
  COOKIE=$(kubectl -n "$NS" get secret "$APP-oauth2-proxy" -o jsonpath='{.data.cookie-secret}' | base64 -d)
fi
COOKIE=${COOKIE:-$(openssl rand -base64 32 | tr -d '\n' | tr '+/' '-_')}
export COOKIE

kubectl -n keycloak get secret "keycloak-$APP" -o json |
  python3 -I -c '
import base64, json, os, sys
app, ns = sys.argv[1:3]
s = base64.b64decode(json.load(sys.stdin)["data"]["client-secret"]).decode()
print(json.dumps({"apiVersion": "v1", "kind": "Secret", "metadata": {"name": app + "-oauth2-proxy", "namespace": ns},
                  "type": "Opaque", "stringData": {"client-id": app, "client-secret": s, "cookie-secret": os.environ["COOKIE"]}}))' \
    "$APP" "$NS" |
  kubectl apply --server-side --force-conflicts -f -
